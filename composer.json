{
    "name": "jdz/mailer",
    "type": "library",
    "description": "JDZ mailer",
    "keywords": [
        "JDZ",
        "utilities",
        "mailer",
        "services"
    ],
    "homepage": "https://jdz.joffreydemetz.com/mailer",
    "license": "MIT",
    "authors": [
        {
            "name": "Joffrey Demetz",
            "email": "joffrey.demetz@gmail.com",
            "homepage": "https://joffreydemetz.com",
            "role": "Lead"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/mailer": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/dotenv": "^7.4",
        "ph-7/html-to-text": "^2.0",
        "soundasleep/html2text": "^2.0",
        "symfony/mailchimp-mailer": "^7.4"
    },
    "suggest": {
        "symfony/mailchimp-mailer": "To send through Mailchimp Transactional (Mandrill), type mailchimp.",
        "ph-7/html-to-text": "To convert the html mail body to plain text with Pierre-Henry de Soria's Html2Text converter.",
        "soundasleep/html2text": "To convert the html mail body to plain text with Sound Asleep Html2Text converter (2.x, for its char_set option)."
    },
    "autoload": {
        "psr-4": {
            "JDZ\\Mailer\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JDZ\\Mailer\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always --testdox",
        "test-coverage": ["@putenv XDEBUG_MODE=coverage", "phpunit --coverage-html coverage"]
    }
}
